# GIS Agent API Keys
# Copy this file to .env and fill in your API keys

# ===== Required =====
GEMINI_API_KEY=your_gemini_api_key_here

# ===== Model Configuration =====
# Provider: "gemini" (default) or "openai_compatible"
MODEL_PROVIDER=gemini
# Custom model name (leave empty for defaults: gemini-2.0-pro-exp-02-05 / gemini-2.0-flash-exp)
MODEL_NAME=
# API base URL for OpenAI-compatible providers (DeepSeek, Ollama, vLLM, etc.)
# Examples:
#   DeepSeek:  https://api.deepseek.com
#   Ollama:    http://localhost:11434/v1
#   vLLM:      http://localhost:8000/v1
MODEL_BASE_URL=
# API key for the model provider (if different from GEMINI_API_KEY)
MODEL_API_KEY=

# ===== Optional =====
TAVILY_API_KEY=your_tavily_api_key_here
EARTHDATA_USER=your_earthdata_username_here
EARTHDATA_PASS=your_earthdata_password_here
EARTHDATA_TOKEN=your_earthdata_token_here
